Ref: verification_claims.created_by > users.id
Ref: claim_evidence.claim_id > verification_claims.id
Ref: claim_evidence.evidence_id > evidence.id
Ref: claim_evidence.added_by > users.id
Ref: verification_decisions.claim_id > verification_claims.id
Ref: verification_decisions.reviewer_id > users.id
Ref: verification_decisions.methodology_version_id > methodology_versions.id
Ref: verification_decisions.previous_decision_id > verification_decisions.id
Ref: decision_evidence.decision_id > verification_decisions.id
Ref: decision_evidence.evidence_id > evidence.id
Ref: organization_verifications.organization_id > organizations.id
Ref: organization_verifications.scope_id > verification_scopes.id
Ref: organization_verifications.methodology_version_id > methodology_versions.id
Ref: organization_verifications.reviewer_id > users.id
Ref: organization_verifications.current_decision_id > verification_decisions.id
Ref: verification_events.organization_id > organizations.id
Ref: verification_events.claim_id > verification_claims.id
Ref: verification_events.decision_id > verification_decisions.id
Ref: verification_events.evidence_id > evidence.id
Ref: verification_events.document_id > documents.id
Ref: verification_events.project_id > projects.id
Ref: verification_events.review_id > reviews.id
Ref: verification_events.actor_id > users.id
Ref: verification_events.methodology_version_id > methodology_versions.id

Ref: projects.organization_id > organizations.id
Ref: projects.created_by > users.id
Ref: projects.updated_by > users.id
Ref: project_verifications.project_id > projects.id
Ref: project_verifications.reviewer_id > users.id
Ref: project_verifications.methodology_version_id > methodology_versions.id
Ref: client_relations.organization_id > organizations.id
Ref: client_relations.project_id > projects.id
Ref: client_relations.client_user_id > users.id
Ref: client_invites.organization_id > organizations.id
Ref: client_invites.project_id > projects.id
Ref: client_invites.client_relation_id > client_relations.id
Ref: client_invites.invited_by > users.id

Ref: reviews.organization_id > organizations.id
Ref: reviews.project_id > projects.id
Ref: reviews.client_relation_id > client_relations.id
Ref: reviews.client_invite_id > client_invites.id
Ref: review_responses.review_id > reviews.id
Ref: review_responses.organization_id > organizations.id
Ref: review_responses.author_user_id > users.id
Ref: review_disputes.review_id > reviews.id
Ref: review_disputes.organization_id > organizations.id
Ref: review_disputes.raised_by > users.id
Ref: review_disputes.resolved_by > users.id
Ref: review_resolutions.review_id > reviews.id
Ref: review_resolutions.organization_id > organizations.id
Ref: review_resolutions.initiated_by > users.id
Ref: resolution_messages.resolution_id > review_resolutions.id
Ref: resolution_messages.sender_user_id > users.id
Ref: review_reports.review_id > reviews.id
Ref: review_reports.reason_id > report_reasons.id
Ref: review_reports.reporter_user_id > users.id
Ref: review_reports.reporter_organization_id > organizations.id
Ref: review_reports.handled_by > users.id
Ref: moderation_actions.review_id > reviews.id
Ref: moderation_actions.moderator_id > users.id
Ref: antifraud_signals.review_id > reviews.id
Ref: antifraud_signals.organization_id > organizations.id

Ref: campaigns.organization_id > organizations.id
Ref: campaigns.created_by > users.id
