Ref: invoices.subscription_id > subscriptions.id
Ref: invoice_items.invoice_id > invoices.id
Ref: payments.invoice_id > invoices.id
Ref: payments.organization_id > organizations.id

Ref: notifications.organization_id > organizations.id
Ref: notifications.created_by > users.id
