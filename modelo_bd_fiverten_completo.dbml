Ref: review_requests.campaign_id > campaigns.id
Ref: review_requests.project_id > projects.id
Ref: review_requests.client_relation_id > client_relations.id
Ref: review_requests.review_id > reviews.id
Ref: review_requests.created_by > users.id

Ref: public_badges.organization_id > organizations.id

Ref: plan_limits.plan_id > plans.id
Ref: subscriptions.organization_id > organizations.id
Ref: subscriptions.plan_id > plans.id
