# ============================================================================
# FIVERTEN - Backend (NestJS) - Plantilla de variables de entorno
# Copia este archivo a .env y ajusta los valores.
# ============================================================================

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fiverten?schema=public"

# Row-Level Security: si DB_RLS_ENABLED=true la app se conecta con este rol
# NO propietario (aplica las politicas de Row-Level Security). Configura las
# politicas con: npm run db:rls
#
# IMPORTANTE:
#  - En produccion DB_RLS_ENABLED debe ser true (la app lo exige al arrancar).
#  - Define APP_DB_PASSWORD con una contrasena fuerte y usa el mismo valor en
#    APP_DATABASE_URL. `npm run db:rls` fija esa contrasena en el rol.
DB_RLS_ENABLED=true
APP_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
APP_DATABASE_URL=postgresql://fiverten_app:CHANGE_ME_STRONG_PASSWORD@localhost:5432/fiverten?schema=public

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=change-me-access-secret-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

REFRESH_COOKIE_NAME=fiverten_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

MAX_FAILED_LOGINS=5
LOCK_MINUTES=15

# Correo y enlaces (frontend)
FRONTEND_URL=http://localhost:3000
MAIL_FROM=no-reply@fiverten.local
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# Si REQUIRE_EMAIL_VERIFICATION=true, el login (y el registro) exigen que el
# correo este verificado; el registro no emite sesion hasta verificar el correo.
REQUIRE_EMAIL_VERIFICATION=false

# Transporte de correo: smtp | json | log. Vacio = smtp si SMTP_HOST esta definido, si no json.
MAIL_TRANSPORT=
# Servidor SMTP real (obligatorio si MAIL_TRANSPORT=smtp o SMTP_HOST esta definido)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ============================================================================
# Imagenes (Cloudflare R2, API compatible con S3)
# Todo esta preparado; rellena estas variables para activar las subidas.
# Si faltan, los endpoints de subida responden 503 (la app arranca igual).
# ============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL publica del bucket (r2.dev o dominio propio), sin barra final.
# Ej: https://pub-xxxxxxxxxxxx.r2.dev
R2_PUBLIC_BASE_URL=
# Opcionales:
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
