// ============================================================================
// FIVERTEN - Prisma schema (subconjunto: identidad, tenancy y autenticación)
// Mapea a los nombres de tabla/columna reales del modelo SQL.
// Motor: PostgreSQL 13+
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                     String    @id @default(uuid()) @db.Uuid
  publicId               String    @unique @map("public_id") @db.VarChar(32)
  legalName              String?   @map("legal_name") @db.VarChar(255)
  tradeName              String    @map("trade_name") @db.VarChar(200)
  slug                   String    @unique @db.VarChar(180)
  taxId                  String?   @map("tax_id") @db.VarChar(50)
  description            String?   @db.Text
  logoUrl                String?   @map("logo_url") @db.VarChar(500)
  coverUrl               String?   @map("cover_url") @db.VarChar(500)
  website                String?   @db.VarChar(255)
  email                  String?   @db.VarChar(255)
  phone                  String?   @db.VarChar(50)
  sectorId               String?   @map("sector_id") @db.Uuid
  countryId              String?   @map("country_id") @db.Uuid
  locale                 String    @default("es") @db.VarChar(10)
  billingCurrency        String    @default("EUR") @map("billing_currency") @db.Char(3)
  status                 String    @default("pending") @db.VarChar(20)
  verificationStatus     String    @default("not_verified") @map("verification_status") @db.VarChar(20)
  verificationComputedAt DateTime? @map("verification_computed_at") @db.Timestamptz(6)
  verifiedAt             DateTime? @map("verified_at") @db.Timestamptz(6)
  verificationExpiresAt  DateTime? @map("verification_expires_at") @db.Timestamptz(6)
  isActive               Boolean   @default(true) @map("is_active")
  isPublic               Boolean   @default(false) @map("is_public")
  allowContact           Boolean   @default(false) @map("allow_contact")
  hideLowRatings         Boolean   @default(false) @map("hide_low_ratings")
  // Avisos al publicarse una reseña (en la app y por correo a los responsables).
  notifyNewReviews       Boolean   @default(true) @map("notify_new_reviews")
  notifyNegativeReviews  Boolean   @default(true) @map("notify_negative_reviews")
  metadata               Json      @default("{}") @db.JsonB
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy              String?   @map("created_by") @db.Uuid
  updatedBy              String?   @map("updated_by") @db.Uuid
  deletedBy              String?   @map("deleted_by") @db.Uuid

  users              User[]                   @relation("UserDefaultOrg")
  roles              Role[]
  memberships        OrganizationMembership[]
  sessions           Session[]
  invitations        OrganizationInvitation[]
  reviews            Review[]
  reviewRevisions    ReviewRevision[]
  reviewResolutions  ReviewResolution[]
  resolutionMessages ResolutionMessage[]
  reviewCases        ReviewCase[]
  reviewCaseMessages ReviewCaseMessage[]
  reviewCaseFiles    ReviewCaseFile[]
  reviewRequests     ReviewRequest[]
  reviewCampaigns    ReviewCampaign[]
  notifications      Notification[]

  sector             Sector?               @relation(fields: [sectorId], references: [id])
  country            Country?              @relation(fields: [countryId], references: [id])
  subscription       Subscription?
  subscriptionEvents SubscriptionEvent[]
  payments           Payment[]
  supportTickets     SupportTicket[]
  supportMessages    SupportTicketMessage[]
  mediaFiles         MediaFile[]
  verificationRequests  VerificationRequest[]
  verificationDocuments VerificationDocument[]
  verificationProjects  VerificationProject[]
  verificationEvents    VerificationEvent[]
  certifications        Certification[]

  @@index([slug])
  @@index([status, isActive, deletedAt])
  @@index([verificationStatus, deletedAt])
  @@index([sectorId])
  @@index([countryId])
  @@map("organizations")
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique @db.VarChar(255)
  username              String    @unique @db.VarChar(100)
  passwordHash          String    @map("password_hash") @db.VarChar(255)
  firstName             String?   @map("first_name") @db.VarChar(100)
  lastName              String?   @map("last_name") @db.VarChar(100)
  phone                 String?   @db.VarChar(50)
  avatarUrl             String?   @map("avatar_url") @db.VarChar(500)
  defaultOrganizationId String?   @map("default_organization_id") @db.Uuid
  isActive              Boolean   @default(true) @map("is_active")
  isVerified            Boolean   @default(false) @map("is_verified")
  isFivertenStaff       Boolean   @default(false) @map("is_fiverten_staff")
  isSuperAdmin          Boolean   @default(false) @map("is_super_admin")
  isSupportAgent        Boolean   @default(false) @map("is_support_agent")
  isVerifier            Boolean   @default(false) @map("is_verifier")
  lastLoginAt           DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt     DateTime? @map("password_changed_at") @db.Timestamptz(6)
  emailVerifiedAt       DateTime? @map("email_verified_at") @db.Timestamptz(6)
  failedLoginCount      Int       @default(0) @map("failed_login_count")
  lockedUntil           DateTime? @map("locked_until") @db.Timestamptz(6)
  blockedAt             DateTime? @map("blocked_at") @db.Timestamptz(6)
  blockReason           String?   @map("block_reason") @db.VarChar(255)
  mfaEnabled            Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEncrypted    String?   @map("mfa_secret_encrypted") @db.VarChar(512)
  metadata              Json      @default("{}") @db.JsonB
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy             String?   @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  deletedBy             String?   @map("deleted_by") @db.Uuid

  defaultOrganization Organization?            @relation("UserDefaultOrg", fields: [defaultOrganizationId], references: [id])
  memberships         OrganizationMembership[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  authAttempts        AuthAttempt[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordResetToken[]
  notifications       Notification[]
  supportTicketsCreated  SupportTicket[] @relation("SupportTicketCreator")
  supportTicketsAssigned SupportTicket[] @relation("SupportTicketAssignee")
  supportMessages        SupportTicketMessage[]
  mediaFiles             MediaFile[]

  @@index([isActive, deletedAt])
  @@index([isFivertenStaff])
  @@map("users")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  slug           String    @db.VarChar(120)
  baseRole       String?   @map("base_role") @db.VarChar(20)
  description    String?   @db.Text
  scope          String    @default("organization") @db.VarChar(20)
  isActive       Boolean   @default(true) @map("is_active")
  isSystem       Boolean   @default(false) @map("is_system")
  priority       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  OrganizationMembership[]
  permissions  RolePermission[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive, deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(50)
  scope       String   @default("organization") @db.VarChar(50)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model OrganizationMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  isOwner        Boolean  @default(false) @map("is_owner")
  isActive       Boolean  @default(true) @map("is_active")
  invitedBy      String?  @map("invited_by") @db.Uuid
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, isActive])
  @@map("organization_memberships")
}

// Invitación a una organización. El alta de un miembro nunca es directa: el
// invitado recibe un enlace de un solo uso y decide si acepta (con su cuenta
// existente o creando una nueva con su propia contraseña).
model OrganizationInvitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.VarChar(255)
  role           String    @db.VarChar(20)
  isOwner        Boolean   @default(false) @map("is_owner")
  firstName      String?   @map("first_name") @db.VarChar(100)
  lastName       String?   @map("last_name") @db.VarChar(100)
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  invitedBy      String?   @map("invited_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedBy     String?   @map("accepted_by") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, acceptedAt, revokedAt])
  @@index([email])
  @@map("organization_invitations")
}

// Reseña de un cliente. Sigue las dimensiones de estado del modelo completo
// (modelo_bd_fiverten_completo.sql): ciclo de vida, verificación, visibilidad
// y moderación son independientes. Se publica cuando el autor confirma su email.
model Review {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  reviewerName       String    @map("reviewer_name") @db.VarChar(200)
  reviewerEmail      String    @map("reviewer_email") @db.VarChar(255)
  projectId          String?   @map("project_id") @db.Uuid
  rating             Int       @db.SmallInt
  title              String?   @db.VarChar(255)
  body               String    @db.Text
  experienceDate     DateTime? @map("experience_date") @db.Date
  orderReference     String?   @map("order_reference") @db.VarChar(100)
  consent            Boolean   @default(false)
  lifecycleStatus    String    @default("submitted") @map("lifecycle_status") @db.VarChar(20)
  verificationStatus String    @default("identified") @map("verification_status") @db.VarChar(20)
  verificationMethodology String? @map("verification_methodology") @db.VarChar(200)
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  visibility         String    @default("private") @db.VarChar(20)
  moderationStatus   String    @default("none") @map("moderation_status") @db.VarChar(20)
  confirmTokenHash   String?   @unique @map("confirm_token_hash") @db.VarChar(255)
  emailConfirmedAt   DateTime? @map("email_confirmed_at") @db.Timestamptz(6)
  publishedAt        DateTime? @map("published_at") @db.Timestamptz(6)
  ipAddress          String?   @map("ip_address") @db.VarChar(45)
  userAgent          String?   @map("user_agent") @db.VarChar(500)
  metadata           Json      @default("{}") @db.JsonB
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project           VerificationProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  response          ReviewResponse?
  reports           ReviewReport[]
  moderationActions ModerationAction[]
  resolutions       ReviewResolution[]
  case              ReviewCase?
  reviewRequest     ReviewRequest?
  revisions         ReviewRevision[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, lifecycleStatus, moderationStatus])
  @@index([organizationId, rating])
  @@index([organizationId, createdAt])
  @@index([organizationId, publishedAt])
  @@index([publishedAt])
  @@index([ipAddress])
  @@index([organizationId, reviewerEmail])
  @@index([projectId])
  @@map("reviews")
}

// Respuesta pública de la empresa, mostrada debajo de la reseña.
// Historial de cambios de una opinión publicada. Conserva los valores previos
// para que una edición posterior a la revisión siga siendo trazable.
model ReviewRevision {
  id             String   @id @default(uuid()) @db.Uuid
  reviewId       String   @map("review_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  previousRating Int?     @map("previous_rating") @db.SmallInt
  newRating      Int?     @map("new_rating") @db.SmallInt
  previousTitle  String?  @map("previous_title") @db.VarChar(255)
  newTitle       String?  @map("new_title") @db.VarChar(255)
  previousBody   String?  @map("previous_body") @db.Text
  newBody        String?  @map("new_body") @db.Text
  reason         String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  review       Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
  @@index([organizationId, createdAt])
  @@map("review_revisions")
}

model ReviewResponse {
  id             String    @id @default(uuid()) @db.Uuid
  reviewId       String    @unique @map("review_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  authorUserId   String?   @map("author_user_id") @db.Uuid
  body           String    @db.Text
  isPublic       Boolean   @default(true) @map("is_public")
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("review_responses")
}

// Catálogo de motivos de reporte (spam, contenido ofensivo, ...).
model ReportReason {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  label       String   @db.VarChar(150)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reports ReviewReport[]

  @@map("report_reasons")
}

// Reporte de una reseña por una empresa o un visitante. Lo resuelve moderación.
model ReviewReport {
  id                     String    @id @default(uuid()) @db.Uuid
  reviewId               String    @map("review_id") @db.Uuid
  reasonId               String?   @map("reason_id") @db.Uuid
  reporterUserId         String?   @map("reporter_user_id") @db.Uuid
  reporterOrganizationId String?   @map("reporter_organization_id") @db.Uuid
  comment                String?   @db.Text
  status                 String    @default("open") @db.VarChar(20)
  ipAddress              String?   @map("ip_address") @db.VarChar(45)
  handledBy              String?   @map("handled_by") @db.Uuid
  handledAt              DateTime? @map("handled_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  review Review        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reason ReportReason? @relation(fields: [reasonId], references: [id])

  @@index([reviewId])
  @@index([status, createdAt])
  @@map("review_reports")
}

// Historial de cambios de estado de una reseña (quién, qué, por qué).
model ModerationAction {
  id          String   @id @default(uuid()) @db.Uuid
  reviewId    String   @map("review_id") @db.Uuid
  moderatorId String?  @map("moderator_id") @db.Uuid
  action      String   @db.VarChar(30)
  fromStatus  String?  @map("from_status") @db.VarChar(20)
  toStatus    String?  @map("to_status") @db.VarChar(20)
  reason      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
  @@index([moderatorId])
  @@map("moderation_actions")
}

// Resolución de una incidencia entre la empresa y el cliente que dejó una reseña
// negativa. El cliente participa desde un enlace con token (no necesita cuenta).
// Estados y resultados según modelo_bd_fiverten_completo.sql (review_resolutions).
model ReviewResolution {
  id             String    @id @default(uuid()) @db.Uuid
  reviewId       String    @map("review_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  initiatedBy    String?   @map("initiated_by") @db.Uuid
  status         String    @default("open") @db.VarChar(20)
  outcome        String?   @db.VarChar(20)
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  review       Review              @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     ResolutionMessage[]

  @@index([reviewId, status])
  @@index([organizationId, status])
  @@map("review_resolutions")
}

// Mensajes de la conversación de una resolución. El remitente es la empresa,
// el cliente o el sistema (avisos automáticos).
model ResolutionMessage {
  id             String   @id @default(uuid()) @db.Uuid
  resolutionId   String   @map("resolution_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  senderType     String   @map("sender_type") @db.VarChar(20)
  senderUserId   String?  @map("sender_user_id") @db.Uuid
  body           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  resolution   ReviewResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([resolutionId, createdAt])
  @@map("resolution_messages")
}

// Caso de evidencias de una reseña de baja valoración. El super admin pide
// pruebas al cliente, las valida, da voz a la empresa y decide: rechazar la
// reseña, publicarla o retirarla si las tres partes llegan a un acuerdo.
model ReviewCase {
  id                   String    @id @default(uuid()) @db.Uuid
  reviewId             String    @unique @map("review_id") @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  status               String    @default("awaiting_admin") @db.VarChar(30)
  outcome              String?   @db.VarChar(20)
  clientTokenHash      String?   @unique @map("client_token_hash") @db.VarChar(255)
  clientTokenExpiresAt DateTime? @map("client_token_expires_at") @db.Timestamptz(6)
  companyNotifiedAt    DateTime? @map("company_notified_at") @db.Timestamptz(6)
  clientAgreedAt       DateTime? @map("client_agreed_at") @db.Timestamptz(6)
  companyAgreedAt      DateTime? @map("company_agreed_at") @db.Timestamptz(6)
  decisionReason       String?   @map("decision_reason") @db.Text
  decidedBy            String?   @map("decided_by") @db.Uuid
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  review       Review              @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     ReviewCaseMessage[]
  files        ReviewCaseFile[]

  @@index([status])
  @@index([organizationId, status])
  @@map("review_cases")
}

// Mensajes del caso. Remitente: admin, client, company o system.
model ReviewCaseMessage {
  id             String   @id @default(uuid()) @db.Uuid
  caseId         String   @map("case_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  senderType     String   @map("sender_type") @db.VarChar(20)
  senderUserId   String?  @map("sender_user_id") @db.Uuid
  body           String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  case         ReviewCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  files        ReviewCaseFile[]

  @@index([caseId, createdAt])
  @@map("review_case_messages")
}

// Archivos de evidencia. Se guardan en la base (no en el almacenamiento
// público) porque pueden contener datos personales: solo se descargan con
// sesión de admin o empresa, o con el enlace del cliente.
model ReviewCaseFile {
  id             String   @id @default(uuid()) @db.Uuid
  caseId         String   @map("case_id") @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  filename       String   @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  size           Int
  data           Bytes
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  case         ReviewCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  message      ReviewCaseMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([messageId])
  @@map("review_case_files")
}

// Solicitud personalizada de reseña. Cada fila representa un enlace único
// enviado a un cliente concreto; permite saber si se abrió y si terminó en
// reseña (seguimiento y tasa de conversión de las solicitudes).
model ReviewRequest {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  reviewerName   String    @map("reviewer_name") @db.VarChar(200)
  reviewerEmail  String    @map("reviewer_email") @db.VarChar(255)
  // sent -> opened -> completed. El vencimiento se calcula con expiresAt.
  status         String    @default("sent") @db.VarChar(20)
  sentAt         DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  openedAt       DateTime? @map("opened_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  reviewId       String?   @unique @map("review_id") @db.Uuid
  campaignId     String?   @map("campaign_id") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  review       Review?         @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  campaign     ReviewCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, reviewerEmail])
  @@index([campaignId])
  @@map("review_requests")
}

// Campaña de solicitud de reseñas: agrupa enlaces personalizados enviados a
// un lote de clientes para medir apertura, respuestas y conversión.
model ReviewCampaign {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(150)
  // draft | active | completed
  status         String    @default("draft") @db.VarChar(20)
  createdBy      String?   @map("created_by") @db.Uuid
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests     ReviewRequest[]

  @@index([organizationId, status, createdAt])
  @@map("review_campaigns")
}

// Notificación del centro de avisos del panel. Una fila por destinatario
// (miembro de la empresa), para que cada uno marque sus leídas.
model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String    @db.VarChar(30)
  title          String    @db.VarChar(200)
  body           String    @db.Text
  link           String?   @db.VarChar(500)
  reviewId       String?   @map("review_id") @db.Uuid
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, createdAt])
  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  organizationId   String?   @map("organization_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  deviceId         String?   @map("device_id") @db.VarChar(255)
  platform         String?   @db.VarChar(100)
  country          String?   @db.VarChar(50)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?   @map("revoke_reason") @db.VarChar(255)
  compromisedAt    DateTime? @map("compromised_at") @db.Timestamptz(6)
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  tokens       RefreshToken[]

  @@index([userId, isActive])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  sessionId         String?   @map("session_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(255)
  familyId          String?   @map("family_id") @db.Uuid
  replacedByTokenId String?   @unique @map("replaced_by_token_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?   @map("revoke_reason") @db.VarChar(255)
  isUsed            Boolean   @default(false) @map("is_used")
  usedAt            DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    Session?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId, isUsed, revokedAt])
  @@index([familyId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("email_verifications")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(500)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("password_reset_tokens")
}

model AuthAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  email         String?  @db.VarChar(255)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  attemptType   String   @default("login") @map("attempt_type") @db.VarChar(30)
  success       Boolean  @default(false)
  failureReason String?  @map("failure_reason") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
  @@map("auth_attempts")
}

// ============================================================================
// Membresías, suscripciones, pagos y configuración de plataforma
// ============================================================================

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(40)
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  priceMonthly Decimal  @default(0) @map("price_monthly") @db.Decimal(10, 2)
  priceYearly  Decimal  @default(0) @map("price_yearly") @db.Decimal(10, 2)
  currency     String   @default("EUR") @db.Char(3)
  // null = sin límite.
  reviewLimit  Int?     @map("review_limit")
  userLimit    Int?     @map("user_limit")
  features     Json     @default("{}") @db.JsonB
  isActive     Boolean  @default(true) @map("is_active")
  isPublic     Boolean  @default(true) @map("is_public")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@index([isActive, sortOrder])
  @@map("plans")
}

model Subscription {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @unique @map("organization_id") @db.Uuid
  planId             String    @map("plan_id") @db.Uuid
  // trialing | active | past_due | cancelled | expired
  status             String    @default("trialing") @db.VarChar(20)
  // monthly | yearly
  billingCycle       String    @default("monthly") @map("billing_cycle") @db.VarChar(20)
  currentPeriodStart DateTime  @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime  @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan                @relation(fields: [planId], references: [id])
  events       SubscriptionEvent[]
  payments     Payment[]

  @@index([planId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // created | plan_changed | status_changed | cancelled | renewed
  type           String   @db.VarChar(30)
  fromPlanId     String?  @map("from_plan_id") @db.Uuid
  toPlanId       String?  @map("to_plan_id") @db.Uuid
  fromStatus     String?  @map("from_status") @db.VarChar(20)
  toStatus       String?  @map("to_status") @db.VarChar(20)
  note           String?  @db.Text
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([organizationId, createdAt])
  @@map("subscription_events")
}

model Payment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  subscriptionId String?   @map("subscription_id") @db.Uuid
  amount         Decimal   @db.Decimal(10, 2)
  currency       String    @default("EUR") @db.Char(3)
  // paid | pending | failed | refunded
  status         String    @default("paid") @db.VarChar(20)
  // manual | card | transfer | other
  method         String    @default("manual") @db.VarChar(20)
  reference      String?   @db.VarChar(120)
  periodStart    DateTime? @map("period_start") @db.Date
  periodEnd      DateTime? @map("period_end") @db.Date
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

model PlatformSetting {
  key         String   @id @db.VarChar(100)
  value       Json     @db.JsonB
  description String?  @db.VarChar(255)
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

// Catálogos globales editables por el super admin.
model Sector {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizations Organization[]

  @@index([isActive, sortOrder])
  @@map("sectors")
}

model Country {
  id        String   @id @default(uuid()) @db.Uuid
  iso2      String   @unique @db.Char(2)
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizations Organization[]

  @@index([isActive, sortOrder])
  @@map("countries")
}

model Language {
  code      String   @id @db.VarChar(10)
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("languages")
}

model EmailTemplate {
  code      String   @id @db.VarChar(60)
  subject   String   @db.VarChar(200)
  title     String   @db.VarChar(200)
  intro     String   @db.Text
  action    String   @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("email_templates")
}

// ============================================================================
// Soporte: tickets de empresas y conversación con el equipo de soporte
// ============================================================================

model SupportTicket {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  subject        String    @db.VarChar(200)
  // general | billing | reviews | technical | account | other
  category       String    @default("general") @db.VarChar(40)
  // low | normal | high | urgent
  priority       String    @default("normal") @db.VarChar(20)
  // open | pending | resolved | closed
  status         String    @default("open") @db.VarChar(20)
  assignedTo     String?   @map("assigned_to") @db.Uuid
  lastMessageAt  DateTime  @default(now()) @map("last_message_at") @db.Timestamptz(6)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User                   @relation("SupportTicketCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  assignee     User?                  @relation("SupportTicketAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  messages     SupportTicketMessage[]

  @@index([organizationId, status, lastMessageAt])
  @@index([assignedTo, status])
  @@index([status, priority, lastMessageAt])
  @@map("support_tickets")
}

model SupportTicketMessage {
  id             String   @id @default(uuid()) @db.Uuid
  ticketId       String   @map("ticket_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // company | support | system
  senderType     String   @map("sender_type") @db.VarChar(20)
  senderUserId   String?  @map("sender_user_id") @db.Uuid
  body           String   @db.Text
  // Nota interna: visible solo para el equipo de soporte.
  isInternal     Boolean  @default(false) @map("is_internal")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender       User?         @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([organizationId, createdAt])
  @@map("support_ticket_messages")
}

// Imágenes subidas sin R2: almacenamiento de respaldo en la base de datos.
// Las imágenes son públicas (logo, portada, avatar); la escritura se limita al
// tenant o al propio usuario.
model MediaFile {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  kind           String   @db.VarChar(20)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  size           Int
  data           Bytes
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("media_files")
}

// ============================================================================
// Verificación de empresa y sello dinámico
// ============================================================================

model VerificationRequest {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  // draft | submitted | in_review | approved | rejected | revoked
  status         String    @default("draft") @db.VarChar(20)
  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz(6)
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  decisionReason String?   @map("decision_reason") @db.Text
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    VerificationDocument[]
  projects     VerificationProject[]
  events       VerificationEvent[]

  @@index([organizationId, status, createdAt])
  @@index([status, createdAt])
  @@map("verification_requests")
}

model VerificationDocument {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestId      String?  @map("request_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  // identity | tax | address | project | other
  category       String   @db.VarChar(30)
  evidenceType   String?  @map("evidence_type") @db.VarChar(30)
  filename       String   @db.VarChar(255)
  mimeType       String   @map("mime_type") @db.VarChar(100)
  size           Int
  data           Bytes
  dataOrigin     String   @default("company_submitted") @map("data_origin") @db.VarChar(30)
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      VerificationRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  project      VerificationProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([requestId])
  @@index([projectId])
  @@map("verification_documents")
}

model VerificationProject {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestId      String?  @map("request_id") @db.Uuid
  name           String   @db.VarChar(200)
  projectType    String?  @map("project_type") @db.VarChar(50)
  city           String?  @db.VarChar(120)
  year           Int?
  status         String   @default("completed") @db.VarChar(20)
  clientStatus   String   @default("identified") @map("client_status") @db.VarChar(20)
  description    String?  @db.Text
  url            String?  @db.VarChar(500)
  dataOrigin     String   @default("company_submitted") @map("data_origin") @db.VarChar(30)
  verificationScope String? @map("verification_scope") @db.VarChar(200)
  methodology    String?  @db.VarChar(200)
  verifiedAt     DateTime? @map("verified_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      VerificationRequest?   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  documents    VerificationDocument[]
  reviews      Review[]

  @@index([organizationId, createdAt])
  @@index([requestId])
  @@map("verification_projects")
}

// Credenciales o certificaciones externas aportadas por la empresa y
// validadas por FIVERTEN. No se publican hasta que un administrador las aprueba.
model Certification {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.VarChar(200)
  issuer         String    @db.VarChar(200)
  credentialId   String?   @map("credential_id") @db.VarChar(200)
  credentialUrl  String?   @map("credential_url") @db.VarChar(500)
  issuedAt       DateTime? @map("issued_at") @db.Date
  expiresAt      DateTime? @map("expires_at") @db.Date
  status         String    @default("pending") @db.VarChar(20)
  dataOrigin     String    @default("source_derived") @map("data_origin") @db.VarChar(30)
  decisionReason String?   @map("decision_reason") @db.Text
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([status, createdAt])
  @@map("certifications")
}

// Trazabilidad obligatoria de cada cambio de estado de verificación.
model VerificationEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  requestId      String?   @map("request_id") @db.Uuid
  actorId        String?   @map("actor_id") @db.Uuid
  actorType      String    @map("actor_type") @db.VarChar(30)
  action         String    @db.VarChar(40)
  previousStatus String?   @map("previous_status") @db.VarChar(20)
  newStatus      String?   @map("new_status") @db.VarChar(20)
  reason         String?   @db.Text
  source         String?   @db.VarChar(200)
  evidence       String?   @db.Text
  dataOrigin     String    @default("fiverten_verified") @map("data_origin") @db.VarChar(30)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request      VerificationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([requestId, createdAt])
  @@map("verification_events")
}

// Solicitudes de captación recibidas desde /verificar-empresa.
model VerificationInquiry {
  id          String    @id @default(uuid()) @db.Uuid
  companyName String    @map("company_name") @db.VarChar(200)
  contactName String    @map("contact_name") @db.VarChar(120)
  email       String    @db.VarChar(255)
  phone       String?   @db.VarChar(50)
  message     String?   @db.Text
  status      String    @default("new") @db.VarChar(20)
  notes       String?   @db.Text
  handledBy   String?   @map("handled_by") @db.Uuid
  handledAt   DateTime? @map("handled_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([email])
  @@map("verification_inquiries")
}




