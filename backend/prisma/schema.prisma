// ============================================================================
// FIVERTEN - Prisma schema (subconjunto: identidad, tenancy y autenticación)
// Mapea a los nombres de tabla/columna reales del modelo SQL.
// Motor: PostgreSQL 13+
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                     String    @id @default(uuid()) @db.Uuid
  publicId               String    @unique @map("public_id") @db.VarChar(32)
  legalName              String?   @map("legal_name") @db.VarChar(255)
  tradeName              String    @map("trade_name") @db.VarChar(200)
  slug                   String    @unique @db.VarChar(180)
  taxId                  String?   @map("tax_id") @db.VarChar(50)
  description            String?   @db.Text
  logoUrl                String?   @map("logo_url") @db.VarChar(500)
  coverUrl               String?   @map("cover_url") @db.VarChar(500)
  website                String?   @db.VarChar(255)
  email                  String?   @db.VarChar(255)
  phone                  String?   @db.VarChar(50)
  sectorId               String?   @map("sector_id") @db.Uuid
  countryId              String?   @map("country_id") @db.Uuid
  locale                 String    @default("es") @db.VarChar(10)
  billingCurrency        String    @default("EUR") @map("billing_currency") @db.Char(3)
  status                 String    @default("pending") @db.VarChar(20)
  verificationStatus     String    @default("not_verified") @map("verification_status") @db.VarChar(20)
  verificationComputedAt DateTime? @map("verification_computed_at") @db.Timestamptz(6)
  verifiedAt             DateTime? @map("verified_at") @db.Timestamptz(6)
  verificationExpiresAt  DateTime? @map("verification_expires_at") @db.Timestamptz(6)
  isActive               Boolean   @default(true) @map("is_active")
  isPublic               Boolean   @default(false) @map("is_public")
  allowContact           Boolean   @default(false) @map("allow_contact")
  metadata               Json      @default("{}") @db.JsonB
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy              String?   @map("created_by") @db.Uuid
  updatedBy              String?   @map("updated_by") @db.Uuid
  deletedBy              String?   @map("deleted_by") @db.Uuid

  users       User[]                   @relation("UserDefaultOrg")
  roles       Role[]
  memberships OrganizationMembership[]
  sessions    Session[]
  invitations OrganizationInvitation[]
  reviews     Review[]

  @@index([slug])
  @@index([status, isActive, deletedAt])
  @@index([verificationStatus, deletedAt])
  @@index([sectorId])
  @@index([countryId])
  @@map("organizations")
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique @db.VarChar(255)
  username              String    @unique @db.VarChar(100)
  passwordHash          String    @map("password_hash") @db.VarChar(255)
  firstName             String?   @map("first_name") @db.VarChar(100)
  lastName              String?   @map("last_name") @db.VarChar(100)
  phone                 String?   @db.VarChar(50)
  avatarUrl             String?   @map("avatar_url") @db.VarChar(500)
  defaultOrganizationId String?   @map("default_organization_id") @db.Uuid
  isActive              Boolean   @default(true) @map("is_active")
  isVerified            Boolean   @default(false) @map("is_verified")
  isFivertenStaff       Boolean   @default(false) @map("is_fiverten_staff")
  isSuperAdmin          Boolean   @default(false) @map("is_super_admin")
  lastLoginAt           DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt     DateTime? @map("password_changed_at") @db.Timestamptz(6)
  emailVerifiedAt       DateTime? @map("email_verified_at") @db.Timestamptz(6)
  failedLoginCount      Int       @default(0) @map("failed_login_count")
  lockedUntil           DateTime? @map("locked_until") @db.Timestamptz(6)
  blockedAt             DateTime? @map("blocked_at") @db.Timestamptz(6)
  blockReason           String?   @map("block_reason") @db.VarChar(255)
  mfaEnabled            Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEncrypted    String?   @map("mfa_secret_encrypted") @db.VarChar(512)
  metadata              Json      @default("{}") @db.JsonB
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBy             String?   @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  deletedBy             String?   @map("deleted_by") @db.Uuid

  defaultOrganization Organization?            @relation("UserDefaultOrg", fields: [defaultOrganizationId], references: [id])
  memberships         OrganizationMembership[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  authAttempts        AuthAttempt[]
  emailVerifications  EmailVerification[]
  passwordResets      PasswordResetToken[]

  @@index([isActive, deletedAt])
  @@index([isFivertenStaff])
  @@map("users")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  name           String    @db.VarChar(100)
  slug           String    @db.VarChar(120)
  baseRole       String?   @map("base_role") @db.VarChar(20)
  description    String?   @db.Text
  scope          String    @default("organization") @db.VarChar(20)
  isActive       Boolean   @default(true) @map("is_active")
  isSystem       Boolean   @default(false) @map("is_system")
  priority       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  OrganizationMembership[]
  permissions  RolePermission[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive, deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(50)
  scope       String   @default("organization") @db.VarChar(50)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model OrganizationMembership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  isOwner        Boolean  @default(false) @map("is_owner")
  isActive       Boolean  @default(true) @map("is_active")
  invitedBy      String?  @map("invited_by") @db.Uuid
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, isActive])
  @@map("organization_memberships")
}

// Invitación a una organización. El alta de un miembro nunca es directa: el
// invitado recibe un enlace de un solo uso y decide si acepta (con su cuenta
// existente o creando una nueva con su propia contraseña).
model OrganizationInvitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.VarChar(255)
  role           String    @db.VarChar(20)
  firstName      String?   @map("first_name") @db.VarChar(100)
  lastName       String?   @map("last_name") @db.VarChar(100)
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  invitedBy      String?   @map("invited_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedBy     String?   @map("accepted_by") @db.Uuid
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, acceptedAt, revokedAt])
  @@index([email])
  @@map("organization_invitations")
}

// Reseña de un cliente. Sigue las dimensiones de estado del modelo completo
// (modelo_bd_fiverten_completo.sql): ciclo de vida, verificación, visibilidad
// y moderación son independientes. Se publica cuando el autor confirma su email.
model Review {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  reviewerName       String    @map("reviewer_name") @db.VarChar(200)
  reviewerEmail      String    @map("reviewer_email") @db.VarChar(255)
  rating             Int       @db.SmallInt
  title              String?   @db.VarChar(255)
  body               String    @db.Text
  experienceDate     DateTime? @map("experience_date") @db.Date
  orderReference     String?   @map("order_reference") @db.VarChar(100)
  consent            Boolean   @default(false)
  lifecycleStatus    String    @default("submitted") @map("lifecycle_status") @db.VarChar(20)
  verificationStatus String    @default("not_verified") @map("verification_status") @db.VarChar(20)
  visibility         String    @default("private") @db.VarChar(20)
  moderationStatus   String    @default("none") @map("moderation_status") @db.VarChar(20)
  confirmTokenHash   String?   @unique @map("confirm_token_hash") @db.VarChar(255)
  emailConfirmedAt   DateTime? @map("email_confirmed_at") @db.Timestamptz(6)
  publishedAt        DateTime? @map("published_at") @db.Timestamptz(6)
  ipAddress          String?   @map("ip_address") @db.VarChar(45)
  userAgent          String?   @map("user_agent") @db.VarChar(500)
  metadata           Json      @default("{}") @db.JsonB
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  response          ReviewResponse?
  reports           ReviewReport[]
  moderationActions ModerationAction[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, lifecycleStatus, moderationStatus])
  @@index([organizationId, rating])
  @@index([publishedAt])
  @@index([ipAddress])
  @@index([organizationId, reviewerEmail])
  @@map("reviews")
}

// Respuesta pública de la empresa, mostrada debajo de la reseña.
model ReviewResponse {
  id             String    @id @default(uuid()) @db.Uuid
  reviewId       String    @unique @map("review_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  authorUserId   String?   @map("author_user_id") @db.Uuid
  body           String    @db.Text
  isPublic       Boolean   @default(true) @map("is_public")
  editedAt       DateTime? @map("edited_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("review_responses")
}

// Catálogo de motivos de reporte (spam, contenido ofensivo, ...).
model ReportReason {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  label       String   @db.VarChar(150)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reports ReviewReport[]

  @@map("report_reasons")
}

// Reporte de una reseña por una empresa o un visitante. Lo resuelve moderación.
model ReviewReport {
  id                     String    @id @default(uuid()) @db.Uuid
  reviewId               String    @map("review_id") @db.Uuid
  reasonId               String?   @map("reason_id") @db.Uuid
  reporterUserId         String?   @map("reporter_user_id") @db.Uuid
  reporterOrganizationId String?   @map("reporter_organization_id") @db.Uuid
  comment                String?   @db.Text
  status                 String    @default("open") @db.VarChar(20)
  ipAddress              String?   @map("ip_address") @db.VarChar(45)
  handledBy              String?   @map("handled_by") @db.Uuid
  handledAt              DateTime? @map("handled_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  review Review        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reason ReportReason? @relation(fields: [reasonId], references: [id])

  @@index([reviewId])
  @@index([status, createdAt])
  @@map("review_reports")
}

// Historial de cambios de estado de una reseña (quién, qué, por qué).
model ModerationAction {
  id          String   @id @default(uuid()) @db.Uuid
  reviewId    String   @map("review_id") @db.Uuid
  moderatorId String?  @map("moderator_id") @db.Uuid
  action      String   @db.VarChar(30)
  fromStatus  String?  @map("from_status") @db.VarChar(20)
  toStatus    String?  @map("to_status") @db.VarChar(20)
  reason      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
  @@index([moderatorId])
  @@map("moderation_actions")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  organizationId   String?   @map("organization_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash") @db.VarChar(255)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  deviceId         String?   @map("device_id") @db.VarChar(255)
  platform         String?   @db.VarChar(100)
  country          String?   @db.VarChar(50)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?   @map("revoke_reason") @db.VarChar(255)
  compromisedAt    DateTime? @map("compromised_at") @db.Timestamptz(6)
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  tokens       RefreshToken[]

  @@index([userId, isActive])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  sessionId         String?   @map("session_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(255)
  familyId          String?   @map("family_id") @db.Uuid
  replacedByTokenId String?   @unique @map("replaced_by_token_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?   @map("revoke_reason") @db.VarChar(255)
  isUsed            Boolean   @default(false) @map("is_used")
  usedAt            DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    Session?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId, isUsed, revokedAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("email_verifications")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  userAgent String?   @map("user_agent") @db.VarChar(500)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("password_reset_tokens")
}

model AuthAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  email         String?  @db.VarChar(255)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  attemptType   String   @default("login") @map("attempt_type") @db.VarChar(30)
  success       Boolean  @default(false)
  failureReason String?  @map("failure_reason") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
  @@map("auth_attempts")
}
