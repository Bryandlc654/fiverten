{
    "name":  "fiverten-backend",
    "version":  "0.1.0",
    "description":  "FIVERTEN API - autenticacion (registro e inicio de sesión)",
    "private":  true,
    "scripts":  {
                    "postinstall":  "prisma generate",
                    "build":  "prisma generate \u0026\u0026 tsc -p tsconfig.build.json",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "eslint src test prisma --ext .ts",
                    "lint:fix":  "eslint src test prisma --ext .ts --fix",
                    "format":  "prettier --write \"{src,test,prisma}/**/*.ts\"",
                    "format:check":  "prettier --check \"{src,test,prisma}/**/*.ts\"",
                    "start":  "node dist/main.js",
                    "start:dev":  "ts-node src/main.ts",
                    "start:prod":  "node dist/main.js",
                    "prisma:generate":  "prisma generate",
                    "prisma:migrate":  "prisma migrate dev",
                    "prisma:deploy":  "prisma migrate deploy",
                    "prisma:studio":  "prisma studio",
                    "prisma:validate":  "prisma validate",
                    "db:rls":  "ts-node prisma/rls/apply.ts",
                    "db:rls:sql":  "ts-node prisma/rls/render.ts",
                    "db:encrypt-files":  "ts-node prisma/encrypt-files.ts",
                    "db:retention":  "ts-node prisma/retention.ts",
                    "db:seed":  "ts-node prisma/seed.ts",
                    "db:seed:demo":  "ts-node prisma/seed-demo.ts",
                    "test":  "jest --config ./test/jest-e2e.json --runInBand",
                    "test:e2e":  "jest --config ./test/jest-e2e.json --runInBand"
                },
    "overrides":  {
                      "lodash":  "4.18.1",
                      "glob":  "14.0.3",
                      "minimatch":  "11.0.4",
                      "picomatch":  "4.0.7",
                      "tmp":  "0.2.7",
                      "webpack":  "5.112.2",
                      "body-parser":  "1.20.9",
                      "multer":  "2.5.0",
                      "qs":  "6.17.1",
                      "file-type":  "22.3.0"
                  },
    "dependencies":  {
                         "@aws-sdk/client-s3":  "^3.1149.0",
                         "@nestjs/common":  "11.1.18",
                         "@nestjs/config":  "4.0.3",
                         "@nestjs/core":  "11.1.18",
                         "@nestjs/jwt":  "11.0.2",
                         "@nestjs/passport":  "11.0.5",
                         "@nestjs/platform-express":  "11.1.18",
                         "@nestjs/throttler":  "^6.7.1",
                         "@node-rs/argon2":  "^2.2.2",
                         "@prisma/client":  "^5.22.0",
                         "bcryptjs":  "^2.4.3",
                         "class-transformer":  "^0.5.1",
                         "class-validator":  "^0.14.1",
                         "cookie-parser":  "^1.4.7",
                         "helmet":  "^8.3.0",
                         "nodemailer":  "10.3.1",
                         "passport":  "^0.7.0",
                         "passport-jwt":  "^4.0.1",
                         "prisma":  "^5.22.0",
                         "reflect-metadata":  "^0.2.2",
                         "rxjs":  "^7.8.1",
                         "sharp":  "^0.35.5",
                         "typescript":  "^5.6.3"
                     },
    "devDependencies":  {
                            "@nestjs/testing":  "11.1.18",
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/cookie-parser":  "^1.4.7",
                            "@types/express":  "^4.17.21",
                            "@types/jest":  "^29.5.14",
                            "@types/node":  "^20.16.10",
                            "@types/nodemailer":  "^6.4.24",
                            "@types/passport-jwt":  "^4.0.1",
                            "@types/smtp-server":  "^3.5.13",
                            "@types/supertest":  "^6.0.3",
                            "@typescript-eslint/eslint-plugin":  "^8.71.1",
                            "@typescript-eslint/parser":  "^8.71.1",
                            "ajv":  "6.15.0",
                            "eslint":  "^8.57.1",
                            "eslint-config-prettier":  "^9.1.2",
                            "eslint-plugin-prettier":  "^5.5.6",
                            "jest":  "^29.7.0",
                            "prettier":  "^3.9.10",
                            "smtp-server":  "^3.19.18",
                            "source-map-support":  "^0.5.21",
                            "supertest":  "^7.3.1",
                            "ts-jest":  "^29.4.14",
                            "ts-node":  "^10.9.2",
                            "tsconfig-paths":  "^4.2.0"
                        }
}
