# URL que usa el navegador para llamar a la API.
# En produccion con proxy same-origin (recomendado en Render) usar /api
NEXT_PUBLIC_API_URL=/api

# Solo servidor (se lee en build): destino real del backend para proxear /api.
# Ej: http://localhost:4000 en local, https://<backend>.onrender.com en produccion.
# Si se deja vacio, no se crea el proxy y el navegador llama directo a NEXT_PUBLIC_API_URL.
API_PROXY_TARGET=http://localhost:4000
